                            <div class="right">
                                <i class="fab fa-wordpress"></i>
                            </div>
                            <div class="left">
                                <h4>Starter Brand Launch</h4>
                                <p>
                                    Ideal for new businesses that need a polished digital foundation.
                                </p>
                            </div>
                        </div>
                        <div class="content">
                            <div class="price">
                                <h2><sup>$</sup>950</h2>
                            </div>
                            <ul>
                                <li>Logo refinement or starter identity</li>
                                <li>Up to 5-page website design</li>
                                <li>Responsive development setup</li>
                                <li>Basic on-page SEO structure</li>
                                <li>Social profile branding kit</li>
                                <li>Launch support and revisions</li>
                            </ul>
                            <div class="button mt-30">
                                <a class="btn-style-regular" href="contact.html"><span>Get Started</span> <i class="fas fa-arrow-right"></i></a>
                            </div>
                        </div>
                        
                    </div>
                </div>
                <!-- End Single Item -->
                <!-- Single Item -->
                 <div class="col-lg-6 pricing-one-single">
                    <div class="pricing-style-one wow fadeInUp" data-wow-delay="200ms">
                        <div class="pricing-top">
                            <div class="right">
                                <i class="fab fa-bootstrap"></i>
                            </div>
                            <div class="left">
                                <h4>Growth Accelerator</h4>
                                <p>
                                    Built for teams ready to scale traffic, leads, and conversion quality.
                                </p>
                            </div>
                        </div>
                        <div class="content">
                            <div class="price">
                                <h2><sup>$</sup>1850</h2>
                            </div>
                            <ul>
                                <li>Full website redesign or landing funnel</li>
                                <li>SEO audit and keyword roadmap</li>
                                <li>Social media campaign creative</li>
                                <li>Lead generation funnel planning</li>
                                <li>Monthly reporting dashboard</li>
                                <li>Dedicated strategy support</li>
                            </ul>
                            <div class="button mt-30">
                                <a class="btn-style-regular btn-border" href="contact.html"><span>Book a Call</span> <i class="fas fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                 </div>
                <!-- End Single Item -->
